@rendermode InteractiveServer

<button class="btn btn-primary" @onclick="Roll">@roll</button>

@code {
    private int selectedDie = 20;
    private Random diceRoll = new Random();

    [Parameter]
    public int roll {get; set;} = 0;
    [Parameter]
    public EventCallback<int> rollChanged { get; set; }
    
    protected override void OnInitialized()
    {
    }

    private void Roll()
    {
        roll = diceRoll.Next(1,selectedDie+1);
    }
}
