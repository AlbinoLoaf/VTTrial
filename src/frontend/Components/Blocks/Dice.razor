<p role="status">Current count: @rollResult</p>

<button class="btn btn-primary" @onclick="Roll">Roll dice</button>

@code {
    private int selectedDie = 20;
    private Random diceRoll = new Random();
    private int rollResult = 0;

    private void Roll()
    {
        rollResult = diceRoll.Next(1,selectedDie+1);
    }
}
