@rendermode InteractiveServer

@foreach (var die in dice){
  <Die sides="die.sides" @bind-roll="die.roll"/>
}


<p> Total: @Total() </p>
<div> 
  <button class="btn btn-primary" @onclick="AddD20">+</button>
  <button class="btn btn-primary" @onclick="RemoveDie">-</button>
</div>

@code
{
  private List<Die> dice = new List<Die>();

  protected override void OnInitialized()
  {
    AddD20();
  }

  protected void AddD20()
  {
    AddDie(20);
  }

  protected void AddDie(int sides)
  {
    dice.Add(new Die(sides));
  }

  protected int Total(){
    int total = 0;
    foreach (var die in dice)
    {
      total += die.roll;
    }
    return total;
  }

  protected void RemoveDie()
  {
    dice.RemoveAt(dice.Count-1);
  }
  
  protected class Die{
    public int sides {get; set;}
    public int roll {get; set;} = 0;

    public Die(int sides) 
    {
      this.sides = sides;
    }
  }
}
